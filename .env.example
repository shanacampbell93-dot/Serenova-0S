# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values to GitHub.

# Password for the private workspace at /os.
# Leave it unset and the app runs in DEMO MODE: /os is open to anyone with sample data,
# which is useful while you show the project off.
OS_PASSWORD=

# Any long random string. Used to sign the login cookie.
AUTH_SECRET=

# Phase 2 (not needed yet)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ANTHROPIC_API_KEY=
